#!/bin/sh /etc/rc.common
# Powered by NyphexAI
# Developed by Hikaru (i@rua.moe)
# Copyright (C) 2026 Hikaru Chang <i@rua.moe>
# SPDX-License-Identifier: GPL-3.0-or-later
# KDDI au HIKARI helper service: wired 802.1X supplicant and DHCP frame marking

USE_PROCD=1
START=21
STOP=89

. /usr/libexec/kddi/kddi-common.sh

EXTRA_COMMANDS="apply restore"
EXTRA_HELP="
	apply	Write the KDDI settings into /etc/config/network and reload
	restore	Roll /etc/config/network back to the last backup"

kddi_quote() {
	# escape backslashes and double quotes for a wpa_supplicant string
	printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}

kddi_wpa_conf() {
	local dev="$1" eap

	eap="$(echo "$DOT1X_EAP" | tr 'a-z' 'A-Z')"

	mkdir -p "$KDDI_RUN_DIR"

	(
	umask 077
	{
		echo "# generated by /etc/init.d/kddi - do not edit"
		echo "ctrl_interface=$KDDI_WPA_CTRL"
		echo "eapol_version=${DOT1X_VERSION:-1}"
		echo "ap_scan=0"
		echo "fast_reauth=1"
		echo ""
		echo "network={"
		echo "	key_mgmt=IEEE8021X"
		echo "	eap=$eap"
		echo "	eapol_flags=0"
		[ -n "$DOT1X_IDENTITY" ]  && echo "	identity=\"$(kddi_quote "$DOT1X_IDENTITY")\""
		[ -n "$DOT1X_ANONYMOUS" ] && echo "	anonymous_identity=\"$(kddi_quote "$DOT1X_ANONYMOUS")\""
		[ -n "$DOT1X_PASSWORD" ]  && echo "	password=\"$(kddi_quote "$DOT1X_PASSWORD")\""
		[ -n "$DOT1X_CA" ]        && echo "	ca_cert=\"$(kddi_quote "$DOT1X_CA")\""
		[ -n "$DOT1X_CERT" ]      && echo "	client_cert=\"$(kddi_quote "$DOT1X_CERT")\""
		[ -n "$DOT1X_KEY" ]       && echo "	private_key=\"$(kddi_quote "$DOT1X_KEY")\""
		[ -n "$DOT1X_KEYPWD" ]    && echo "	private_key_passwd=\"$(kddi_quote "$DOT1X_KEYPWD")\""
		[ -n "$DOT1X_PHASE2" ]    && echo "	phase2=\"$(kddi_quote "$DOT1X_PHASE2")\""
		echo "}"
	} > "$KDDI_WPA_CONF"
	)

	chmod 600 "$KDDI_WPA_CONF"
}

kddi_nft_start() {
	local dev="$1"

	nft -f - <<-NFT 2>/dev/null && return 0
		table netdev $KDDI_NFT_TABLE { }
		delete table netdev $KDDI_NFT_TABLE
		table netdev $KDDI_NFT_TABLE {
			chain egress {
				type filter hook egress device "$dev" priority filter; policy accept;
				meta protocol ip ip protocol udp udp sport 68 udp dport 67 ip dscp set cs5
			}
		}
	NFT

	kddi_log "unable to install the DSCP CS5 rule on $dev (nftables egress hook unavailable)" warning
	return 1
}

kddi_nft_stop() {
	nft delete table netdev "$KDDI_NFT_TABLE" 2>/dev/null
}

start_service() {
	local dev

	kddi_config_load

	[ "$KDDI_ENABLED" = 1 ] || {
		kddi_log "disabled, not starting"
		return 0
	}

	dev="$(kddi_wan_device)"
	[ -n "$dev" ] || {
		kddi_log "no WAN device configured" err
		return 1
	}

	[ "$KDDI_DSCP" = 1 ] && kddi_nft_start "$dev"

	[ "$DOT1X_ENABLED" = 1 ] || return 0

	[ -x /usr/sbin/wpa_supplicant ] || {
		kddi_log "802.1X is enabled but wpa_supplicant is missing (install wpad-openssl or wpa-supplicant)" err
		return 1
	}

	kddi_wpa_conf "$dev"

	procd_open_instance supplicant
	procd_set_param command /usr/sbin/wpa_supplicant \
		-D wired -i "$dev" -c "$KDDI_WPA_CONF"
	procd_set_param respawn 3600 5 0
	procd_set_param file "$KDDI_WPA_CONF"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	# optional: kick the DHCP client as soon as the port is authorised
	[ -x /usr/sbin/wpa_cli ] && {
		procd_open_instance monitor
		procd_set_param command /usr/sbin/wpa_cli \
			-i "$dev" -p "$KDDI_WPA_CTRL" -a /usr/libexec/kddi/kddi-dot1x-action
		procd_set_param respawn 3600 5 0
		procd_close_instance
	}
}

stop_service() {
	kddi_nft_stop
}

service_triggers() {
	procd_add_reload_trigger "kddi"
}

reload_service() {
	kddi_config_load
	[ "$KDDI_ENABLED" = 1 ] && /usr/libexec/kddi/kddi-apply apply
	kddi_nft_stop
	rc_procd start_service
}

apply() {
	/usr/libexec/kddi/kddi-apply apply
	rc_procd start_service
}

restore() {
	/usr/libexec/kddi/kddi-apply restore "$1"
}

status_service() {
	/usr/libexec/rpcd/kddi call status
}
