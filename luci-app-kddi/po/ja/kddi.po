msgid "KDDI au HIKARI (DHCP client)"
msgstr "KDDI auひかり（DHCP クライアント）"

msgid "Vendor class (option 60)"
msgstr "ベンダークラス（オプション 60）"

msgid "The KDDI provisioning server keys on this string."
msgstr "KDDI の設定配信サーバーはこの文字列で HGW を判別します。"

msgid "Requested lease time (option 51)"
msgstr "要求するリース時間（オプション 51）"

msgid "Seconds. A home gateway asks for 3600. Set to 0 to omit the option."
msgstr "秒単位。ホームゲートウェイは 3600 を要求します。0 でオプションを送信しません。"

msgid "Host name to send (option 12)"
msgstr "送信するホスト名（オプション 12）"

msgid "Left empty a home gateway sends no host name at all."
msgstr "空欄ならホスト名を送信しません（HGW と同じ挙動）。"

msgid "Client ID to send (option 61)"
msgstr "送信するクライアント ID（オプション 61）"

msgid "Left empty no client identifier is sent, which is what a home gateway does."
msgstr "空欄ならクライアント ID を送信しません（HGW と同じ挙動）。"

msgid "Use broadcast flag"
msgstr "ブロードキャストフラグを使用"

msgid "A home gateway asks for a unicast reply, so this stays off."
msgstr "ホームゲートウェイはユニキャスト応答を要求するため、通常はオフです。"

msgid "Request classless static routes (option 121)"
msgstr "クラスレス静的経路を要求（オプション 121）"

msgid "Not requested by a home gateway."
msgstr "ホームゲートウェイは要求しません。"

msgid "Requested options (option 55)"
msgstr "要求するオプション一覧（オプション 55）"

msgid "Leave empty for the home gateway list 1, 3, 6, 12, 15, 28, 43."
msgstr "空欄で HGW と同じ 1, 3, 6, 12, 15, 28, 43 を使用します。"

msgid "Additional options to send"
msgstr "追加で送信するオプション"

msgid "udhcpc syntax, e.g. %s."
msgstr "udhcpc の書式（例: %s）。"

msgid "Plugin"
msgstr "プラグイン"

msgid "enabled"
msgstr "有効"

msgid "disabled"
msgstr "無効"

msgid "Protocol handler"
msgstr "プロトコルハンドラ"

msgid "registered in netifd"
msgstr "netifd に登録済み"

msgid "installed, netifd restart pending"
msgstr "インストール済み、netifd の再起動が必要"

msgid "missing"
msgstr "未インストール"

msgid "WAN device"
msgstr "WAN デバイス"

msgid "MAC address"
msgstr "MAC アドレス"

msgid "HGW address active"
msgstr "HGW のアドレスで動作中"

msgid "does not match %s"
msgstr "%s と一致しません"

msgid "no HGW address configured"
msgstr "HGW のアドレスが未設定"

msgid "Interface %s does not exist yet."
msgstr "インターフェース %s はまだ存在しません。"

msgid "Status"
msgstr "状態"

msgid "connected"
msgstr "接続済み"

msgid "not connected"
msgstr "未接続"

msgid "Protocol"
msgstr "プロトコル"

msgid "IPv4 address"
msgstr "IPv4 アドレス"

msgid "Gateway"
msgstr "ゲートウェイ"

msgid "DNS servers"
msgstr "DNS サーバー"

msgid "DHCP server"
msgstr "DHCP サーバー"

msgid "Lease time"
msgstr "リース時間"

msgid "Connected"
msgstr "接続時間"

msgid "IPv6 is disabled in the plugin settings."
msgstr "設定で IPv6 が無効になっています。"

msgid "Delegated prefix"
msgstr "委任プレフィックス"

msgid "Address"
msgstr "アドレス"

msgid "IPv4 over IPv6"
msgstr "IPv4 over IPv6"

msgid "no address"
msgstr "アドレスなし"

msgid "no S46 rule received"
msgstr "S46 ルールを受信していません"

msgid "802.1X authentication is disabled."
msgstr "802.1X 認証は無効です。"

msgid "Supplicant"
msgstr "サプリカント"

msgid "running"
msgstr "動作中"

msgid "stopped"
msgstr "停止"

msgid "EAP method"
msgstr "EAP 方式"

msgid "State"
msgstr "状態"

msgid "unknown"
msgstr "不明"

msgid "install wpa-cli to read the state"
msgstr "状態の取得には wpa-cli が必要です"

msgid "EAP state"
msgstr "EAP 状態"

msgid "Port status"
msgstr "ポート状態"

msgid "DHCPv4 vendor class (60)"
msgstr "DHCPv4 ベンダークラス（60）"

msgid "DHCPv4 request list (55)"
msgstr "DHCPv4 要求オプション一覧（55）"

msgid "DHCPv4 client ID (61)"
msgstr "DHCPv4 クライアント ID（61）"

msgid "not sent"
msgstr "送信しない"

msgid "DHCPv4 host name (12)"
msgstr "DHCPv4 ホスト名（12）"

msgid "DHCPv4 lease request (51)"
msgstr "DHCPv4 リース要求（51）"

msgid "DHCPv6 DUID"
msgstr "DHCPv6 DUID"

msgid "generated by netifd"
msgstr "netifd が生成"

msgid "DHCPv6 IA_PD IAID"
msgstr "DHCPv6 IA_PD IAID"

msgid "DHCPv6 client FQDN (39)"
msgstr "DHCPv6 クライアント FQDN（39）"

msgid "Done."
msgstr "完了しました。"

msgid "Failed."
msgstr "失敗しました。"

msgid "Overview"
msgstr "概要"

msgid "IPv4 (%s)"
msgstr "IPv4（%s）"

msgid "IPv6 (%s)"
msgstr "IPv6（%s）"

msgid "802.1X"
msgstr "802.1X"

msgid "Fingerprint sent to KDDI"
msgstr "KDDI へ送信する識別情報"

msgid "Log"
msgstr "ログ"

msgid "No related log messages yet."
msgstr "関連するログはまだありません。"

msgid "KDDI au HIKARI"
msgstr "KDDI auひかり"

msgid "Status of the WAN connection that impersonates a KDDI home gateway."
msgstr "KDDI ホームゲートウェイを模倣した WAN 接続の状態です。"

msgid "Write network config"
msgstr "ネットワーク設定を書き込む"

msgid "Renew lease"
msgstr "アドレスを再取得"

msgid "Re-authenticate 802.1X"
msgstr "802.1X を再認証"

msgid "Restart service"
msgstr "サービスを再起動"

msgid "Restore network backup"
msgstr "ネットワーク設定を復元"

msgid "Make this router present itself to the KDDI access network like the home gateway it replaces. Saving writes the matching <em>wan</em> / <em>wan6</em> interfaces into the network configuration; the previous network configuration is kept in %s."
msgstr "置き換え対象のホームゲートウェイとして KDDI 網に接続します。保存すると <em>wan</em> / <em>wan6</em> インターフェースがネットワーク設定に書き込まれ、以前の設定は %s に保存されます。"

msgid "General"
msgstr "基本設定"

msgid "IPv6"
msgstr "IPv6"

msgid "Advanced"
msgstr "詳細設定"

msgid "Enable"
msgstr "有効にする"

msgid "Take over the WAN interfaces. Leave this off to keep the current WAN configuration untouched."
msgstr "WAN インターフェースを引き継ぎます。オフのままなら現在の WAN 設定は変更されません。"

msgid "Physical port that is wired to the ONU / media converter."
msgstr "ONU／メディアコンバータに接続している物理ポート。"

msgid "HGW MAC address"
msgstr "HGW の MAC アドレス"

msgid "WAN side MAC address of the home gateway, printed on its label or shown in its web interface. It is cloned onto the WAN device and used to build the DHCPv6 DUID."
msgstr "ホームゲートウェイの WAN 側 MAC アドレス（本体ラベルまたは設定画面で確認）。WAN デバイスに複製され、DHCPv6 DUID の生成にも使われます。"

msgid "Vendor class (DHCPv4 option 60)"
msgstr "ベンダークラス（DHCPv4 オプション 60）"

msgid "Identifier the KDDI DHCP server expects from a home gateway."
msgstr "KDDI の DHCP サーバーが HGW に期待する識別子。"

msgid "HGW model name"
msgstr "HGW の型番"

msgid "Sent as the DHCPv6 client FQDN (option 39), e.g. %s."
msgstr "DHCPv6 クライアント FQDN（オプション 39）として送信します（例: %s）。"

msgid "Requested lease time"
msgstr "要求するリース時間"

msgid "DHCPv4 option 51, in seconds. A home gateway asks for 3600."
msgstr "DHCPv4 オプション 51（秒）。ホームゲートウェイは 3600 を要求します。"

msgid "Enable IPv6"
msgstr "IPv6 を有効にする"

msgid "Runs a DHCPv6 client that asks for a prefix delegation only, exactly like the home gateway."
msgstr "ホームゲートウェイと同じく、プレフィックス委任のみを要求する DHCPv6 クライアントを動かします。"

msgid "Requested prefix length"
msgstr "要求するプレフィックス長"

msgid "automatic (no hint, like the HGW)"
msgstr "自動（ヒントなし、HGW と同じ）"

msgid "IA_PD identifier"
msgstr "IA_PD 識別子（IAID）"

msgid "Hexadecimal IAID used in the prefix delegation request."
msgstr "プレフィックス委任要求で使用する 16 進数の IAID。"

msgid "Accept IPv4 over IPv6 rules"
msgstr "IPv4 over IPv6 ルールを受け入れる"

msgid "Hand MAP-E / MAP-T / lw4o6 rules received over DHCPv6 to the %s protocol. Requires the %s package."
msgstr "DHCPv6 で受信した MAP-E／MAP-T／lw4o6 ルールを %s プロトコルに渡します。%s パッケージが必要です。"

msgid "IPv4 interface name"
msgstr "IPv4 インターフェース名"

msgid "Logical interface that is rewritten with the KDDI settings."
msgstr "KDDI 設定が書き込まれる論理インターフェース。"

msgid "IPv6 interface name"
msgstr "IPv6 インターフェース名"

msgid "Keep interfaces in the wan zone"
msgstr "インターフェースを wan ゾーンに保つ"

msgid "Adds the interfaces to the firewall zone named <em>wan</em> if they are missing."
msgstr "<em>wan</em> ゾーンに含まれていない場合は自動的に追加します。"

msgid "Mark DHCP frames with DSCP CS5"
msgstr "DHCP フレームに DSCP CS5 を付与"

msgid "The home gateway sends its DHCPv4 frames with DSCP CS5. This needs nftables egress hook support and has no effect on the address assignment itself."
msgstr "ホームゲートウェイは DHCPv4 フレームを DSCP CS5 で送信します。nftables の egress フックが必要で、アドレス取得自体には影響しません。"

msgid "802.1X authentication"
msgstr "802.1X 認証"

msgid "KDDI home gateways start an EAPOL exchange on the WAN port before requesting an address. Enable this only if you have the credentials or certificates your line requires; they cannot be recovered from a packet capture."
msgstr "KDDI のホームゲートウェイはアドレス取得前に WAN ポートで EAPOL を開始します。回線に必要な認証情報や証明書がある場合のみ有効にしてください。これらはパケットキャプチャからは復元できません。"

msgid "Runs wpa_supplicant in wired mode on the WAN device. Requires %s."
msgstr "WAN デバイス上で wpa_supplicant を有線モードで実行します。%s が必要です。"

msgid "Identity"
msgstr "識別子（Identity）"

msgid "Password"
msgstr "パスワード"

msgid "Anonymous identity"
msgstr "匿名識別子"

msgid "Inner authentication"
msgstr "内部認証"

msgid "wpa_supplicant syntax, e.g. %s."
msgstr "wpa_supplicant の書式（例: %s）。"

msgid "CA certificate"
msgstr "CA 証明書"

msgid "Path on the router, e.g. %s."
msgstr "ルーター上のパス（例: %s）。"

msgid "Client certificate"
msgstr "クライアント証明書"

msgid "Private key"
msgstr "秘密鍵"

msgid "Private key password"
msgstr "秘密鍵のパスワード"

msgid "EAPOL version"
msgstr "EAPOL バージョン"

msgid "The capture shows a home gateway using version 1 (IEEE 802.1X-2001)."
msgstr "キャプチャではホームゲートウェイはバージョン 1（IEEE 802.1X-2001）を使用しています。"
